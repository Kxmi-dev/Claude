<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LKDS-Join-Builder</AssemblyName>
    <RootNamespace>Lkds.Join.Builder</RootNamespace>
    <DebugType>none</DebugType>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\Shared.csproj" />
    <!-- Microsoft-Paket für LDAP-Abfragen; in .NET selbst nicht enthalten -->
    <PackageReference Include="System.DirectoryServices" Version="9.0.0" />
  </ItemGroup>

</Project>
