<Window x:Class="Lkds.Builder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LKDS AD Join Builder" Width="620" Height="640" MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="LKDS AD Join Builder" Style="{StaticResource Title}"/>
            <TextBlock x:Name="StepText" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <Grid>
                <!-- Schritt 1: AD-Verbindung -->
                <ScrollViewer x:Name="Page1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Profil" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="ProfileBox" IsEditable="True" DisplayMemberPath="Name"
                                      SelectionChanged="ProfileBox_SelectionChanged"/>
                            <Button Grid.Column="1" Content="Speichern" Margin="8,0,0,0" Padding="12,6" Click="SaveProfile_Click"/>
                            <Button Grid.Column="2" Content="Löschen" Margin="8,0,0,0" Padding="12,6" Click="DeleteProfile_Click"/>
                        </Grid>

                        <TextBlock Text="Domäne" Style="{StaticResource Label}"/>
                        <TextBox x:Name="DomainBox"/>
                        <TextBlock Text="Basis-OU" Style="{StaticResource Label}"/>
                        <TextBox x:Name="BaseOuBox"/>

                        <CheckBox x:Name="CurrentUserCheck" Margin="0,16,0,0" Checked="CurrentUserCheck_Changed" Unchecked="CurrentUserCheck_Changed"/>
                        <TextBlock Text="Benutzer" Style="{StaticResource Label}"/>
                        <TextBox x:Name="ConnUserBox"/>
                        <TextBlock Text="Passwort (wird nie gespeichert)" Style="{StaticResource Label}"/>
                        <PasswordBox x:Name="ConnPasswordBox"/>

                        <Button Content="Mit Active Directory verbinden" Style="{StaticResource Primary}"
                                Margin="0,20,0,0" HorizontalAlignment="Left" Click="Connect_Click"/>
                        <TextBlock x:Name="ConnStatus" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Schritt 2: Standorte -->
                <Grid x:Name="Page2" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Welche Standorte soll die EXE enthalten?" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="LocationList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Selected}" Content="{Binding Name}" ToolTip="{Binding Dn}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- Schritt 3: Benutzer -->
                <Grid x:Name="Page3" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Welche AD-Benutzer dürfen den Join durchführen?" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="UserList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding Selected}" Content="{Binding Name}"/>
                                        <Button Grid.Column="1" Content="Entfernen" Padding="8,2" FontSize="12" Click="RemoveUser_Click"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="NewUserBox" KeyDown="NewUserBox_KeyDown"/>
                        <Button Grid.Column="1" Content="Hinzufügen" Margin="8,0,0,0" Click="AddUser_Click"/>
                    </Grid>
                </Grid>

                <!-- Schritt 4: EXE erstellen -->
                <ScrollViewer x:Name="Page4" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Name der EXE" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                        <TextBox x:Name="ExeNameBox" Text="LKDS-Join.exe" TextChanged="Summary_Changed"/>
                        <TextBlock Text="Ausgabeordner" Style="{StaticResource Label}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="OutputBox" TextChanged="Summary_Changed"/>
                            <Button Grid.Column="1" Content="Auswählen …" Margin="8,0,0,0" Click="BrowseFolder_Click"/>
                        </Grid>
                        <CheckBox x:Name="LdsCheck" IsChecked="True" Margin="0,16,0,0" Checked="LdsCheck_Changed" Unchecked="LdsCheck_Changed"
                                  Content="Standard-Nachlauf nach dem Neustart (Programme und Registry aus C:\LDS)"/>
                        <TextBlock Text="Startet ZENworks und Bitdefender und importiert OES.reg, die gewählte DNS-Datei und die übrigen .reg-Dateien. Läuft einmalig als SYSTEM."
                                   Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="22,0,0,0"/>
                        <TextBlock Text="DNS-Dateien zur Auswahl in der Join-EXE (C:\LDS\REG\DNS ….reg)" Style="{StaticResource Label}"/>
                        <ItemsControl x:Name="DnsList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Selected}" Content="{Binding Name}" Margin="0,2,20,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Die Join-EXE wählt je nach Standort eine davon vor (LNBE: LNBE, LNWS: LNRE), man kann sie dort ändern. OES.reg wird immer importiert."
                                   Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/>
                        <TextBlock Text="Zusätzliches Skript (optional, .bat)" Style="{StaticResource Label}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="BatBox" IsReadOnly="True"/>
                            <Button Grid.Column="1" Content="Auswählen …" Margin="8,0,0,0" Click="BrowseBat_Click"/>
                            <Button Grid.Column="2" Content="Entfernen" Margin="8,0,0,0" Click="ClearBat_Click"/>
                        </Grid>
                        <TextBlock Text="Läuft einmalig beim nächsten Start als SYSTEM, nicht als angemeldeter Benutzer. Keine Passwörter in die .bat schreiben, sie steht lesbar in der EXE."
                                   Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <TextBlock Text="Zusammenfassung" Style="{StaticResource Label}" Margin="0,20,0,4"/>
                        <Border BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4" Padding="12">
                            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" LineHeight="22"/>
                        </Border>
                        <Button Content="EXE erstellen" Style="{StaticResource Primary}" Margin="0,20,0,0"
                                HorizontalAlignment="Left" Click="Build_Click"/>
                        <TextBlock x:Name="BuildStatus" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Button x:Name="BackButton" Content="Zurück" HorizontalAlignment="Left" Click="Back_Click"/>
            <Button x:Name="NextButton" Content="Weiter" Style="{StaticResource Primary}" HorizontalAlignment="Right" Click="Next_Click"/>
        </Grid>
    </Grid>
</Window>
