<Window x:Class="Lkds.JoinApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LKDS Computer Join" Width="440" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Border Style="{StaticResource Card}" Margin="16">
        <StackPanel>
            <TextBlock Text="LKDS Computer Join" Style="{StaticResource Title}"/>
            <TextBlock x:Name="DomainText" Foreground="{StaticResource Muted}" Margin="0,4,0,8"/>

            <TextBlock Text="AD-Benutzer" Style="{StaticResource Label}"/>
            <ComboBox x:Name="UserBox"/>

            <TextBlock Text="Standort" Style="{StaticResource Label}"/>
            <ComboBox x:Name="LocationBox" DisplayMemberPath="Name"/>

            <TextBlock Text="Computername" Style="{StaticResource Label}"/>
            <TextBox x:Name="NameBox" MaxLength="15"/>

            <TextBlock Text="Passwort" Style="{StaticResource Label}"/>
            <PasswordBox x:Name="PasswordBox"/>

            <Button x:Name="JoinButton" Content="COMPUTER JOINEN" Style="{StaticResource Primary}"
                    Margin="0,24,0,0" Click="JoinButton_Click"/>

            <TextBlock Text="Status" Style="{StaticResource Label}" Margin="0,20,0,2"/>
            <TextBlock x:Name="StatusText" Text="Bereit" TextWrapping="Wrap"/>
            <Expander x:Name="DetailsExpander" Header="Details" Visibility="Collapsed" Margin="0,8,0,0">
                <TextBox x:Name="DetailsBox" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="100"
                         VerticalScrollBarVisibility="Auto" Margin="0,6,0,0"/>
            </Expander>
        </StackPanel>
    </Border>
</Window>
